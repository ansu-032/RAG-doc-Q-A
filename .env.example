# ==============================================================================
# Citely - Environment Configuration Template
# Copy this file to .env and adjust values as needed for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (PostgreSQL with pgvector extension)
# ------------------------------------------------------------------------------
# Async connection string for SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3-compatible storage)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=password
MINIO_BUCKET=documents

# ------------------------------------------------------------------------------
# Document Ingestion & Validation
# ------------------------------------------------------------------------------
# JSON array of allowed MIME types for uploaded files
ALLOWED_MIME_TYPES=["application/pdf","application/msword","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/markdown","text/x-markdown"]

# Chunking settings (recursive character splitter)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ------------------------------------------------------------------------------
# Vector Embeddings (FastEmbed / HuggingFace)
# ------------------------------------------------------------------------------
# Must match EMBEDDING_DIM=384 defined in src/db/models.py
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=64

# ------------------------------------------------------------------------------
# LLM Providers & Query Routing (Groq API)
# ------------------------------------------------------------------------------
# Primary Groq API key: used for document QA answering and intent routing
GROQ_API_KEY=gsk_your_primary_groq_api_key_here

# Main answer LLM model (grounded document synthesis)
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0

# Router LLM model: classifies queries (document_specific, document_broad, general),
# rewrites queries to resolve coreference, and determines web search necessity.
# Must support strict JSON schema output.
ROUTER_MODEL=openai/gpt-oss-20b

# Secondary Groq API key: dedicated key for fallback general answers and web search synthesis
# Using a separate key prevents general questions from consuming document answering quota.
GENERAL_GROQ_API_KEY=gsk_your_secondary_groq_api_key_here
GENERAL_LLM_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# Retrieval & Vector Search Thresholds
# ------------------------------------------------------------------------------
# Maximum number of top chunks retrieved per query
TOP_K=5
# Minimum cosine similarity threshold (0.0 to 1.0) for chunks to qualify as relevant
MIN_SCORE=0.5

# ------------------------------------------------------------------------------
# Data Lifecycle & Automated Cleanup
# ------------------------------------------------------------------------------
# How often the background scheduler checks for idle sessions (in minutes)
CLEANUP_INTERVAL_MINUTES=60
# Idle duration before all session files, chunks, and storage objects are permanently deleted
CLEANUP_IDLE_MINUTES=60

# ------------------------------------------------------------------------------
# Security & Rate Limiting
# ------------------------------------------------------------------------------
# Set to true in production when serving behind HTTPS
SESSION_COOKIE_SECURE=false

# Sliding window rate limits per client IP (resets hourly)
RATE_LIMIT_QUERIES_PER_HOUR=100
RATE_LIMIT_UPLOADS_PER_HOUR=10

